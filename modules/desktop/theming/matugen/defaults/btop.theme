# Main background and foreground
theme[main_bg] = "#1a120d"
theme[main_fg] = "#f0dfd7"

# Title and headings
theme[title] = "#f0dfd7"
theme[hi_fg] = "#ffb68d"

# Selected/Active items
theme[selected_bg] = "#ffb68d"
theme[selected_fg] = "#532200"

# Inactive items
theme[inactive_fg] = "#d7c2b8"

# Graph/Chart colors
theme[graph_text] = "#f0dfd7"
theme[meter_bg] = "#52443c"
theme[proc_misc] = "#cdc991"
theme[proc_start] = "#ffb68d"
theme[proc_mid] = "#6f3813"
theme[proc_end] = "#e5beaa"

# Cpu/Mem/Disk graphs
theme[cpu_start] = "#ffb68d"
theme[cpu_mid] = "#6f3813"
theme[cpu_end] = "#cdc991"

theme[mem_start] = "#ffb68d"
theme[mem_mid] = "#6f3813"
theme[mem_end] = "#cdc991"

theme[net_start] = "#ffb68d"
theme[net_mid] = "#6f3813"
theme[net_end] = "#cdc991"
